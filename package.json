{
  "name": "@gfn-cis/opencode-squad",
  "version": "0.6.0",
  "description": "OpenCode 2 plugin that turns the build agent into a PDCA orchestrator (sarge) over grunt/drill subagents",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    ".opencode",
    "src",
    "prompts",
    "scripts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "vitest run --config vitest.integration.config.js"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "orchestrator",
    "pdca",
    "subagents"
  ],
  "author": "GFN-CIS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GFN-CIS/opencode-squad.git"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@opencode/ai": "2.1.3",
    "@opencode/core": "2.1.3",
    "@opencode/plugin": "2.1.3",
    "@opencode/sdk": "2.1.3",
    "@opencode/util": "2.1.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "effect": "4.0.1",
    "knip": "^6.32.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "@modelcontextprotocol/client": "^2.3.0"
  }
}
