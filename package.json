  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@opencode-ai/plugin": "^1.15.10",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.32.1",
    "vitest": "^4.1.10"
  }
}
